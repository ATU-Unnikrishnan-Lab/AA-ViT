{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run AA-ViT Locally",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/train.py",
            "python": "${command:python.interpreterPath}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
